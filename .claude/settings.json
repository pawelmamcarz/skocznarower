{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/pre-deploy-d1-check.sh\"",
            "timeout": 60,
            "statusMessage": "Sprawdzam migracje D1 przed deployem..."
          }
        ]
      }
    ]
  }
}
