{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skocznarower",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "main": "src/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "skocznarower.pl/*", "zone_name": "skocznarower.pl" },
    { "pattern": "www.skocznarower.pl/*", "zone_name": "skocznarower.pl" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skocznarower-db",
      "database_id": "1df60167-a71d-4a9c-87d7-3fd5fba9b75f",
      "migrations_dir": "migrations"
    }
  ],
  // Cron co 5 minut obsługuje wyłącznie kolejkę powiadomień i jej backoff.
  // Cron 08:00 UTC = 09:00 lub 10:00 czasu Warszawy (zależnie od DST) uruchamia
  // zadania dobowe: przypomnienia, follow-upy, mailing sezonowy, opinie i cleanup.
  // SMS przez SMSAPI (sekret SMSAPI_TOKEN), mail przez Resend (RESEND_API_KEY),
  // opinie przez GOOGLE_PLACES_API_KEY. Bez tych sekretów Worker tylko loguje (dry-run) i kontynuuje.
  "triggers": {
    "crons": ["*/5 * * * *", "0 8 * * *"]
  },
  "vars": {
    // Bezpośredni link "napisz opinię" dla profilu Google (place_id zweryfikowany w Mapach).
    "REVIEW_LINK": "https://search.google.com/local/writereview?placeid=ChIJy3rjtflJGUcR-vo90y41alc"
  }
}
